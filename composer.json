{
    "name": "daniel-km/omeka-s-module-copidref",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Create resources with data from IdRef and, if missing, create it on IdRef too.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "IdRef",
        "curation"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-CopIdRef",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-CopIdRef/-/issues",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2432)": {
        "omeka/omeka-s": "^4.0",
        "daniel-km/omeka-s-module-common": "*"
    },
    "autoload": {
        "psr-4": {
            "CopIdRef\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CopIdRefTest\\": "tests/CopIdRefTest/"
        }
    },
    "extra": {
        "installer-name": "CopIdRef",
        "configurable": true
    }
}
